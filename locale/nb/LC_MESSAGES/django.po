#, python-format
msgid ""
"%(batch)s in %(unit)s is held (%(withdrawal)s): after this change its withdrawal would end "
"earlier, the fish may go to food from %(after)s instead of %(until)s."
msgstr ""
"%(batch)s i %(unit)s holdes tilbake (%(withdrawal)s): etter denne endringen slutter "
"tilbakeholdelsestiden tidligere, fisken kan gå til mat fra %(after)s i stedet for %(until)s."

