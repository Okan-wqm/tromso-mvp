# A locally managed Cloudflare Tunnel for one farm's console (docs/ops/access.md, option A). Placeholders only: no
# Cloudflare API is called by anything in this repository; the tunnel and its Access application are made by a person
# in the Zero Trust dashboard (or this file is used with `cloudflared tunnel run` and a credentials file).
#
# The dashboard-managed way (recommended, what deploy/compose.yml's `cloudflared` service runs): make the tunnel in
# Zero Trust > Networks > Tunnels, copy its token into SECRETS_DIR/cloudflared.env as TUNNEL_TOKEN=..., add one public
# hostname with the same values as `ingress` below, then `docker compose --profile cloudflare up -d`.
tunnel: 00000000-0000-0000-0000-000000000000            # the tunnel's id
credentials-file: /etc/cloudflared/tunnel.json          # never in git
ingress:
  - hostname: farm.example.invalid                      # SITE_HOST
    service: https://proxy:443                          # the stack's proxy, over the compose network
    originRequest:
      originServerName: farm.example.invalid            # SNI and certificate name the proxy answers to
      # The proxy's certificate: a Cloudflare origin certificate (trusted by Cloudflare), or the farm-internal CA of
      # scripts/certs.sh proxy-internal, then mount its ca.crt and name it here:
      # caPool: /etc/cloudflared/farm-ca.crt
      noTLSVerify: false
  - service: http_status:404
