msgstr "Ölü balıkların ağırlığı (kg)"

#, python-format
msgid "Welcome, %(name)s. The company’s figures will appear here."
msgstr "Hoş geldiniz, %(name)s. Şirketin rakamları burada görünecek."

msgid "Well (groundwater)"
msgstr "Kuyu (yeraltı suyu)"

msgid "Wellboat and transport"
msgstr "Kuyulu tekne ve nakliye"

