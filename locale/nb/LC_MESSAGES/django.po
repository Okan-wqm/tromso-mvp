msgid "%(name)s “%(object)s” created."
msgstr "%(name)s «%(object)s» ble opprettet."

#. Translators: %(name)s is the kind of record, capitalised (e.g. Site); %(object)s is the record.
#, python-format
msgid "%(name)s “%(object)s” deleted."
msgstr "%(name)s «%(object)s» ble slettet."

#. Translators: %(name)s is the kind of record, capitalised (e.g. Site); %(object)s is the record.
#, python-format
msgid "%(name)s “%(object)s” saved."
msgstr "%(name)s «%(object)s» ble lagret."

#, python-format
msgid "%(names)s cannot use Messages."
msgstr "%(names)s kan ikke bruke Meldinger."

#, python-format
msgid "%(number)s deleted"
msgstr "%(number)s slettet"

#, python-format
msgid "%(operation)s of %(date)s voided."
msgstr "%(operation)s (%(date)s) er annullert."

#, python-format
msgid "%(operation)s recorded: %(quantity)s %(unit)s of %(item)s from %(location)s."
msgstr "%(operation)s registrert: %(quantity)s %(unit)s %(item)s fra %(location)s."

#, python-format
msgid "%(owner)s cannot have a point of this kind: %(kinds)s."
msgstr "%(owner)s kan ikke ha et punkt av denne typen: %(kinds)s."

#, python-format
msgid "%(parameter)s: bounds from %(low)s to %(high)s, at most %(decimals)d decimals."
msgstr "%(parameter)s: grenser fra %(low)s til %(high)s, høyst %(decimals)d desimaler."

#, python-format
msgid "%(person)s (can no longer be chosen)"
msgstr "%(person)s (kan ikke velges lenger)"

#, python-format
msgid "%(point)s is deleted."
msgstr "%(point)s er slettet."

#, python-format
msgid "%(point)s is inactive: it takes no new samples."
msgstr "%(point)s er inaktivt: det tar ikke nye prøver."

#, python-format
msgid "%(protocol)s, assigned to %(unit)s, is for %(protocol_species)s; these fish are %(species)s."
msgstr "%(protocol)s, tildelt %(unit)s, er for %(protocol_species)s; denne fisken er %(species)s."

#, python-format
msgid "%(protocol)s: %(sfr)s at %(temperature)s, %(meals)s meal"
msgid_plural "%(protocol)s: %(sfr)s at %(temperature)s, %(meals)s meals"
msgstr[0] "%(protocol)s: %(sfr)s ved %(temperature)s, %(meals)s måltid"
msgstr[1] "%(protocol)s: %(sfr)s ved %(temperature)s, %(meals)s måltider"

#, python-format
msgid "%(rating)s of 5"
msgstr "%(rating)s av 5"

#, python-format
msgid "%(reason)s is not a reason to cull %(batch)s."
msgstr "«%(reason)s» er ikke en grunn til å avlive %(batch)s."

#, python-format
msgid "%(record)s is the primary one"
msgstr "%(record)s er den primære"

#, python-format
msgid "%(record)s was not restored: %(reasons)s"
msgstr "%(record)s ble ikke gjenopprettet: %(reasons)s"

#, python-format
msgid "%(rule)s at %(time)s"
msgstr "%(rule)s kl. %(time)s"

#, python-format
msgid "%(sfr)s at %(temperature)s: %(ration)s a day, %(meals)s × %(meal)s"
msgstr "%(sfr)s ved %(temperature)s: %(ration)s per dag, %(meals)s × %(meal)s"

#, python-format
msgid "%(site)s has no lokalitetsnummer (Facility › Sites)."
msgstr "%(site)s har ikke lokalitetsnummer (Anlegg › Lokaliteter)."

#, python-format
msgid "%(site)s has no organisation number (Facility › Sites, its Reports tab)."
msgstr "%(site)s har ikke organisasjonsnummer (Anlegg › Lokaliteter, fanen Rapporter)."

#, python-format
msgid ""
"%(site)s has no sea temperature at 3 m depth for the week: record a water sample at a depth point"
" of 3 m (Operations › Water chemistry)."
msgstr ""
"%(site)s har ingen sjøtemperatur på 3 m dyp for uken: registrer en vannprøve i et dybdepunkt på 3"
" m (Drift › Vannkjemi)."

#, python-format
msgid ""
"%(site)s has no sea-lice limit area (Facility › Sites): the stricter limit and the larger sample "
"are applied."
msgstr ""
"%(site)s har ikke lusegrenseområde (Anlegg › Lokaliteter): den strengeste grensen og det største "
"utvalget brukes."

#, python-format
msgid "%(size)s mm"
msgstr "%(size)s mm"

#, python-format
msgid "%(size)s: %(grams)s g per shot, silo %(silo)s kg"
msgstr "%(size)s: %(grams)s g per skudd, silo %(silo)s kg"

#, python-format
msgid "%(species)s has no official code (Setup › Reference data › Species)."
msgstr "%(species)s har ingen offisiell kode (Oppsett › Referansedata › Arter)."

#, python-format
msgid "%(species)s is %(status)s: a new batch takes an active or experimental species."
msgstr "%(species)s er %(status)s: en ny fiskegruppe må være av en aktiv art eller en forsøksart."

#, python-format
msgid "%(start)s – %(end)s"
msgstr "%(start)s – %(end)s"

#, python-format
msgid "%(supplier)s is deleted."
msgstr "%(supplier)s er slettet."

#, python-format
msgid "%(supplier)s is not a supplier of %(category)s (Purchasing › Suppliers)."
msgstr "%(supplier)s er ikke leverandør av %(category)s (Innkjøp › Leverandører)."

#, python-format
msgid "%(system)s is on another site than the production department."
msgstr "%(system)s er på en annen lokalitet enn produksjonsavdelingen."

#, python-format
msgid "%(temperature)s °C"
msgstr "%(temperature)s °C"

#, python-format
msgid "%(temperature)s °C is outside this table (%(low)s–%(high)s °C)."
msgstr "%(temperature)s °C er utenfor denne tabellen (%(low)s–%(high)s °C)."

#, python-format
msgid "%(temperature)s °C, %(salinity)s ‰"
msgstr "%(temperature)s °C, %(salinity)s ‰"

#, python-format
msgid "%(unit)s already has a count on %(date)s: void it first to correct it."
msgstr "%(unit)s har allerede en telling %(date)s: annuller den først for å rette den."

#, python-format
msgid "%(unit)s has harvests or count adjustments in the month, which this report has no field for."
msgstr "%(unit)s har høstinger eller telleendringer i måneden, som denne rapporten ikke har felt for."

#, python-format
msgid "%(unit)s has no average weight to report (the authority wants one above 0)."
msgstr "%(unit)s har ingen gjennomsnittsvekt å rapportere (myndigheten vil ha en over 0)."

#, python-format
msgid ""
"%(unit)s has the status %(status)s, so it cannot take fish: it can when it is active, preparing "
"or fallow."
msgstr ""
"%(unit)s har status %(status)s og kan ikke ta imot fisk: det kan den når den er aktiv, klargjøres"
" eller brakklagt."

#, python-format
msgid "%(unit)s has the status %(status)s: set it to preparing or fallow in Setup to stock it."
msgstr ""
"%(unit)s har status %(status)s: sett den til klargjøres eller brakklagt i Oppsett for å sette ut "
"fisk i den."

#, python-format
msgid "%(unit)s held more than one species in the month."
msgstr "%(unit)s hadde mer enn én art i måneden."

#, python-format
msgid ""
"%(unit)s held salmonids and was due a count by %(date)s: count it, or the site’s average is not "
"of every cage."
msgstr ""
"%(unit)s hadde laksefisk og skulle vært telt innen %(date)s: tell den, ellers gjelder ikke "
"lokalitetens gjennomsnitt alle merder."

#, python-format
msgid "%(unit)s holds no cleaner fish on %(date)s."
msgstr "%(unit)s har ingen rensefisk %(date)s."

#, python-format
msgid "%(unit)s holds no fish on %(date)s."
msgstr "%(unit)s har ingen fisk %(date)s."

#, python-format
msgid "%(unit)s is %(depth)s m deep: the point cannot be deeper."
msgstr "%(unit)s er %(depth)s m dyp: punktet kan ikke ligge dypere."

#, python-format
msgid "%(unit)s is deleted and would hold fish again: restore it first."
msgstr "%(unit)s er slettet og ville fått fisk igjen: gjenopprett den først."

#, python-format
msgid "%(unit)s is deleted."
msgstr "%(unit)s er slettet."

#, python-format
msgid "%(unit)s is on no site."
msgstr "%(unit)s er ikke på noen lokalitet."

#, python-format
msgid ""
"%(unit)s was emptied on %(date)s: the fish and the average weight just before are reported "
"(whether Mattilsynet wants that count or 0 is to be confirmed)."
msgstr ""
"%(unit)s ble tømt %(date)s: fisken og gjennomsnittsvekten rett før rapporteres (om Mattilsynet "
"vil ha det antallet eller 0 skal bekreftes)."

#, python-format
msgid ""
"%(unit)s would hold %(kilos)s kg on %(date)s, %(percent)s %% of its max biomass (%(max)s kg at "
"%(density)s kg/m³). Tick the box below to stock it anyway."
msgstr ""
"%(unit)s ville hatt %(kilos)s kg %(date)s, %(percent)s %% av maks. biomasse (%(max)s kg ved "
"%(density)s kg/m³). Kryss av i boksen under for å sette ut likevel."

#, python-format
msgid ""
"%(unit)s would hold %(species)s on %(date)s: a unit holds one species at a time (cleaner fish "
"join the production fish only on a sea site)."
msgstr ""
"%(unit)s ville hatt %(species)s %(date)s: en enhet har én art om gangen (rensefisk kan bare være "
"sammen med produksjonsfisken på en sjølokalitet)."

#, python-format
msgid ""
"%(unit)s would hold %(species)s on %(date)s: a unit holds one species of production fish at a "
"time, beside its cleaner fish."
msgstr ""
"%(unit)s ville hatt %(species)s %(date)s: en enhet har én art produksjonsfisk om gangen, ved "
"siden av rensefisken."

#, python-format
msgid "%(unit)s: %(fish)d fish counted on %(date)s, where the regulation asks for %(least)d in this week."
msgstr "%(unit)s: %(fish)d fisk telt %(date)s, der forskriften krever %(least)d denne uken."

#. Translators: a percentage; write the sign where your language puts it (Turkish: %%%(value)s).
#, python-format
msgid "%(value)s %%"
msgstr "%(value)s %%"

#. Translators: a quantity and its unit, e.g. 1,250.5 kg.
#, python-format
msgid "%(value)s %(unit)s"
msgstr "%(value)s %(unit)s"

#. Translators: days of cover, e.g. 12.5 days.
#, python-format
msgid "%(value)s days"
msgstr "%(value)s dager"

#. Translators: an average weight in grams, e.g. 145 g.
#, python-format
msgid "%(value)s g"
msgstr "%(value)s g"

