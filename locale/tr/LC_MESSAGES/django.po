msgid "%(temperature)s °C, %(salinity)s ‰"
msgstr "%(temperature)s °C, %(salinity)s ‰"

#, python-format
msgid "%(title)s · %(quantity)s · %(tier)s, %(width)s each"
msgstr "%(title)s · %(quantity)s · %(tier)s, her biri %(width)s"

#, python-format
msgid "%(total)s in all"
msgstr "toplam %(total)s"

#, python-format
msgid "%(total)s people you may see in the company."
msgstr "Şirkette görebileceğiniz %(total)s kişi."

#, python-format
msgid "%(total)s person"
msgid_plural "%(total)s people"
msgstr[0] "%(total)s kişi"
msgstr[1] "%(total)s kişi"

#, python-format
msgid "%(unit)s already has a count on %(date)s: void it first to correct it."
msgstr "%(unit)s için %(date)s tarihinde zaten bir sayım var: düzeltmek için önce onu iptal edin."

#, python-format
msgid "%(unit)s has harvests or count adjustments in the month, which this report has no field for."
msgstr "%(unit)s biriminde ay içinde hasat veya sayı düzeltmeleri var; bu raporda bunlar için alan yok."

#, python-format
msgid "%(unit)s has no average weight to report (the authority wants one above 0)."
msgstr "%(unit)s için bildirilecek ortalama ağırlık yok (kurum 0’dan büyük bir değer ister)."

#, python-format
msgid "%(unit)s has no middle sampling point."
msgstr "%(unit)s biriminin orta numune noktası yok."

#, python-format
msgid ""
"%(unit)s has the status %(status)s, so it cannot take fish: it can when it is active, preparing "
"or fallow."
msgstr ""
"%(unit)s şu an %(status)s durumunda, bu yüzden balık alamaz: aktif, hazırlanıyor veya "
"dinlendirmede durumundayken alabilir."

#, python-format
msgid "%(unit)s has the status %(status)s: set it to preparing or fallow in Setup to stock it."
msgstr ""
"%(unit)s şu an %(status)s durumunda: stoklamak için Kurulum’da hazırlanıyor veya dinlendirmede "
"durumuna alın."

#, python-format
msgid ""
"%(unit)s held more than one species in the month and is listed once for each: confirm that "
"Mattilsynet takes one tank number twice."
msgstr ""
"%(unit)s ay içinde birden fazla tür barındırdı ve her tür için bir kez listelendi: Mattilsynet’in"
" aynı kar numarasını iki kez kabul ettiğini doğrulayın."

#, python-format
msgid ""
"%(unit)s held salmonids and was due a count by %(date)s: count it, or the site’s average is not "
"of every cage."
msgstr ""
"%(unit)s’te salmonidler vardı ve sayım %(date)s tarihine kadar yapılmalıydı: sayın, yoksa sahanın"
" ortalaması her kafesi kapsamaz."

#, python-format
msgid "%(unit)s holds no cleaner fish on %(date)s."
msgstr "%(unit)s biriminde %(date)s tarihinde temizleyici balık yok."

#, python-format
msgid "%(unit)s holds no fish on %(date)s."
msgstr "%(unit)s biriminde %(date)s tarihinde balık yok."

#, python-format
msgid "%(unit)s is %(depth)s m deep: the point cannot be deeper."
msgstr "%(unit)s %(depth)s m derinliğinde: nokta bundan derin olamaz."

#, python-format
msgid "%(unit)s is deleted and would hold fish again: restore it first."
msgstr "%(unit)s silinmiş ve yeniden balık tutacaktı: önce onu geri yükleyin."

#, python-format
msgid "%(unit)s is deleted."
msgstr "%(unit)s silinmiş."

#, python-format
msgid "%(unit)s is on no site."
msgstr "%(unit)s hiçbir sahada değil."

#, python-format
msgid ""
"%(unit)s was counted on %(date)s and before that on %(last)s: the regulation asks for a count at "
"least every %(days)d days (§ 6)."
msgstr ""
"%(unit)s %(date)s tarihinde sayıldı, bundan önce %(last)s tarihinde: yönetmelik en az %(days)d "
"günde bir sayım ister (§ 6)."

#, python-format
msgid ""
"%(unit)s was emptied on %(date)s: the fish and the average weight just before are reported "
"(whether Mattilsynet wants that count or 0 is to be confirmed)."
msgstr ""
"%(unit)s %(date)s tarihinde boşaltıldı: hemen öncesindeki balık sayısı ve ortalama ağırlık "
"bildirilir (Mattilsynet’in bu sayıyı mı 0’ı mı istediği teyit edilecek)."

#, python-format
msgid ""
"%(unit)s would hold %(kilos)s kg on %(date)s, %(percent)s %% of its max biomass (%(max)s kg at "
"%(density)s kg/m³). Tick the box below to stock it anyway."
msgstr ""
"%(unit)s %(date)s tarihinde %(kilos)s kg tutacak: azami biyokütlesinin %%%(percent)s kadarı "
"(%(density)s kg/m³ ile %(max)s kg). Yine de stoklamak için aşağıdaki kutuyu işaretleyin."

#, python-format
msgid ""
"%(unit)s would hold %(species)s on %(date)s: a unit holds one species at a time (cleaner fish "
"join the production fish only on a sea site)."
msgstr ""
"%(unit)s, %(date)s tarihinde %(species)s tutardı: bir birimde aynı anda tek tür bulunur "
"(temizleyici balıklar üretim balığına yalnızca deniz sahasında katılır)."

#, python-format
msgid ""
"%(unit)s would hold %(species)s on %(date)s: a unit holds one species of production fish at a "
"time, beside its cleaner fish."
msgstr ""
"%(unit)s, %(date)s tarihinde %(species)s tutardı: bir birimde temizleyici balıkların yanında aynı"
" anda tek üretim balığı türü bulunur."

#, python-format
msgid "%(unit)s: %(fish)d fish counted on %(date)s, where the regulation asks for %(least)d in this week."
msgstr "%(unit)s: %(date)s tarihinde %(fish)d balık sayıldı; yönetmelik bu hafta için %(least)d ister."

#. Translators: a percentage; write the sign where your language puts it (Turkish: %%%(value)s).
#, python-format
msgid "%(value)s %%"
msgstr "%%%(value)s"

#. Translators: a quantity and its unit, e.g. 1,250.5 kg.
#, python-format
msgid "%(value)s %(unit)s"
msgstr "%(value)s %(unit)s"

#. Translators: days of cover, e.g. 12.5 days.
#, python-format
msgid "%(value)s days"
msgstr "%(value)s gün"

#. Translators: an average weight in grams, e.g. 145 g.
#, python-format
msgid "%(value)s g"
msgstr "%(value)s g"

#. Translators: an amount of feed in kilograms, e.g. 12.5 kg.
#. Translators: a weight in kilograms, e.g. 1,798 kg.
#, python-format
msgid "%(value)s kg"
msgstr "%(value)s kg"

#, python-format
msgid "%(value)s kg/m³"
msgstr "%(value)s kg/m³"

#, python-format
msgid "%(value)s per fish"
msgstr "balık başına %(value)s"

#. Translators: a weight in tonnes, e.g. 3.2 t.
#, python-format
msgid "%(value)s t"
msgstr "%(value)s t"

#. Translators: a water temperature, e.g. 13.2 °C.
#, python-format
msgid "%(value)s °C"
msgstr "%(value)s °C"

#, python-format
msgid "%(volume)s m³"
msgstr "%(volume)s m³"

#, python-format
msgid "%(weighed)s round weight, %(book)s in the book"
msgstr "%(weighed)s canlı ağırlık, kayıtta %(book)s"

#, python-format
msgid "%(weight)s as stocked"
msgstr "stoklamada %(weight)s"

#, python-format
msgid "%(weight)s is outside %(protocol)s (%(range)s)."
msgstr "%(weight)s, %(protocol)s protokolünün ağırlık aralıkları dışında (%(range)s)."

#, python-format
msgid "%(weight)s weighed %(date)s"
msgstr "%(date)s tarihinde %(weight)s tartıldı"

#, python-format
msgid "%(when)s by %(who)s"
msgstr "%(when)s, %(who)s"

#, python-format
msgid "%(when)s through %(how)s, recorded by %(who)s"
msgstr "%(when)s, %(how)s yoluyla, kaydeden: %(who)s"

#, python-format
msgid "(%(dose)s g/m³)"
msgstr "(%(dose)s g/m³)"

msgid "(batch in unit)"
msgstr "(birimdeki parti)"

msgid "(has errors)"
msgstr "(hata var)"

#, python-format
msgid "(printed as %(label)s)"
msgstr "(basılı sayfa %(label)s)"

msgid "(unit)"
msgstr "(birim)"

msgid "(unnamed figure)"
msgstr "(adı olmayan değer)"

msgid "(whole batch)"
msgstr "(tüm parti)"

msgid "0 rows"
msgstr "0 satır"

msgid "0 rows match"
msgstr "0 satır eşleşiyor"

msgid ""
"1 October each year, for the two next calendar years (the saved page: \"Fristen for å sende inn "
"driftsplan for 2027 og 2028 er 1. oktober 2026\")"
msgstr ""
"Her yıl 1 Ekim, sonraki iki takvim yılı için (kaydedilen sayfa: \"Fristen for å sende inn "
"driftsplan for 2027 og 2028 er 1. oktober 2026\")"

msgid "1 for every day, 2 for every other day, up to 52."
msgstr "Her gün için 1, iki günde bir için 2; en çok 52."

msgid ""
"1 for every month, 3 for every quarter, up to 52; the months are counted from the first day’s "
"month."
msgstr "Her ay için 1, üç ayda bir için 3; en çok 52. Aylar ilk günün ayından sayılır."

msgid ""
"1 for every week, 2 for every other week, up to 52; the weeks are counted from the first day’s "
"week."
msgstr "Her hafta için 1, iki haftada bir için 2; en çok 52. Haftalar ilk günün haftasından sayılır."

msgid "1 to 31; in a shorter month the 29th, 30th and 31st fall on its last day."
msgstr "1 ile 31 arası; daha kısa bir ayda 29, 30 ve 31 o ayın son gününe düşer."

msgid "1 to 6 letters or digits, as Mattilsynet gives it."
msgstr "Mattilsynet’in verdiği gibi 1 ila 6 harf veya rakam."

msgid "15 July each year, for 1 June to 31 May, by year class"
msgstr "Her yıl 15 Temmuz, 1 Haziran–31 Mayıs dönemi için, yıl sınıfına göre"

msgid "7 January"
msgstr "7 Ocak"

msgid "9-digit Norwegian organisation number"
msgstr "9 haneli Norveç kuruluş numarası"

msgid "A DOI starts with 10. and has no spaces, e.g. 10.1016/j.aquaculture.2019.01.001."
msgstr "DOI 10. ile başlar ve boşluk içermez, örn. 10.1016/j.aquaculture.2019.01.001."

msgid ""
"A Deffeyes diagram: dissolved inorganic carbon across, alkalinity up, lines of equal pH, the "
"regions where CO₂, NH₃ and H₂S pass their limits, the safe zone and the water's point. The values"
" are in the results under the charts."
msgstr ""
"Bir Deffeyes diyagramı: yatayda çözünmüş inorganik karbon, dikeyde alkalinite, eşit pH çizgileri,"
" CO₂, NH₃ ve H₂S’nin sınırlarını aştığı bölgeler, güvenli bölge ve suyun noktası. Değerler "
"çizelgelerin altındaki sonuçlardadır."

msgid ""
"A JSON pointer to the device’s sequence number, e.g. /seq; empty for none. It is shown, never "
"used to refuse a message."
msgstr ""
"Cihazın sıra numarasını gösteren bir JSON pointer, örn. /seq; yoksa boş. Yalnızca gösterilir, "
"hiçbir mesajı reddetmek için kullanılmaz."

msgid ""
"A JSON pointer to the device’s time, e.g. /ts. Empty: the time the message is received, and the "
"reading says so."
msgstr ""
"Cihazın zamanını gösteren bir JSON pointer, örn. /ts. Boş: mesajın alındığı zaman kullanılır ve "
"okuma bunu belirtir."

msgid "A JSON pointer: empty, or starting with “/”."
msgstr "Bir JSON pointer: boş ya da “/” ile başlayan."

#, python-format
msgid ""
"A PDF of up to %(limit)s. Its text is read when it is saved, page by page, for the search and, "
"later, for the AI agents."
msgstr ""
"En fazla %(limit)s büyüklüğünde bir PDF. Metni kaydedilirken sayfa sayfa okunur: arama için ve "
"ileride yapay zekâ ajanları için."

msgid "A batch alone: the protocol follows it into every unit it is moved to."
msgstr "Yalnızca parti: protokol, parti hangi birime taşınırsa onunla birlikte gider."

msgid "A batch goes with a unit, a system, a production department or a site, not with equipment."
msgstr "Bir parti bir birimle, sistemle, üretim departmanıyla veya sahayla gider, ekipmanla değil."

#, python-format
msgid ""
"A batch’s biomass is its last measured average from %(date)s: no weighing in the %(days)d days "
"before the month’s end, and no feeding with a feeding table was recorded since to project it "
"from."
msgstr ""
"Bir partinin biyokütlesi, %(date)s tarihli son ölçülen ortalamasıdır: ay sonundan önceki %(days)d"
" günde tartım yok ve ondan tahmin yürütmek için o günden beri besleme tablosuyla yapılmış bir "
"besleme kaydedilmedi."

#, python-format
msgid ""
"A batch’s biomass is its last measured average from %(date)s: no weighing in the %(days)d days "
"before the month’s end, and the projection has feeding days without a feeding table."
msgstr ""
"Bir partinin biyokütlesi, %(date)s tarihli son ölçülen ortalamadır: ay sonundan önceki %(days)d "
"günde tartım yok ve tahminde yemleme tablosu olmayan yemleme günleri var."

msgid "A bath, a dip or a freshwater bath only."
msgstr "Yalnız banyo, daldırma veya tatlı su banyosu."

msgid ""
"A bath, a medicated feed, an injection or a vaccination, or a treatment without a medicine, is "
"recorded here or from a unit’s drawer on Production units."
msgstr ""
"Bir banyo, ilaçlı yem, enjeksiyon veya aşılama ya da ilaçsız bir tedavi burada veya Üretim "
"birimleri’nde bir birimin panelinden kaydedilir."

msgid ""
"A bath, medicated feed, injection or dip is given with a medicine, the way the medicine is given;"
" the others without one."
msgstr ""
"Banyo, ilaçlı yem, enjeksiyon veya daldırma bir ilaçla, ilacın uygulandığı şekilde yapılır; "
"diğerleri ilaçsız."

msgid "A bath, medicated feed, injection or dip names its medicine."
msgstr "Banyo, ilaçlı yem, enjeksiyon veya daldırma ilacını belirtir."

msgid ""
"A bath, medicated feed, injection or dip names its medicine; a treatment without a medicine names"
" none."
msgstr "Banyo, ilaçlı yem, enjeksiyon veya daldırma ilacını belirtir; ilaçsız bir tedavi ilaç belirtmez."

msgid "A binding cannot end in the future."
msgstr "Bir atama gelecekte bitemez."

msgid "A binding cannot start in the future."
msgstr "Bir atama gelecekte başlayamaz."

msgid "A binding is to one sampling point, one system or one piece of equipment."
msgstr "Bir atama tek bir numune noktasına, tek bir sisteme veya tek bir ekipman parçasına yapılır."

msgid ""
"A binding says where a channel's values belong from a moment on: a sampling point or a system for"
" a water value, a piece of equipment or a system for a process value."
msgstr ""
"Bir atama, bir kanalın değerlerinin belirli bir andan itibaren nereye ait olduğunu belirtir: su "
"değeri için bir numune noktası veya sistem, proses değeri için bir ekipman parçası veya sistem."

msgid "A bioassay"
msgstr "Bir biyodeney"

#, python-format
msgid "A board has at most %(num)d card."
msgid_plural "A board has at most %(num)d cards."
msgstr[0] "Bir panonun en çok %(num)d kartı olabilir."
msgstr[1] "Bir panonun en çok %(num)d kartı olabilir."

msgid ""
"A board is a named wall screen: the units it shows and how each card is drawn. Everyone who may "
"read Monitoring can open it."
msgstr ""
"Pano, adı olan bir duvar ekranıdır: gösterdiği birimler ve her kartın nasıl çizildiği. İzleme'yi "
"okuyabilen herkes açabilir."

msgid "A built-in template cannot be changed; copy it to make one of your own."
msgstr "Yerleşik bir şablon değiştirilemez; kendinize ait bir tane yapmak için kopyalayın."

msgid "A built-in template is never deleted; copy it to make one of your own."
msgstr "Yerleşik bir şablon asla silinmez; kendinize ait bir tane yapmak için kopyalayın."

msgid "A capacity needs its unit, and a unit its capacity."
msgstr "Kapasitenin birimi, birimin de kapasitesi olmalı."

#, python-format
msgid "A card holds at most %(max)d widgets."
msgstr "Bir kartta en fazla %(max)d bileşen olabilir."

msgid ""
"A card template places widgets on a monitoring card; the card’s frame (the unit, its state and "
"why) is always shown."
msgstr ""
"Bir kart şablonu, izleme kartına bileşenler yerleştirir; kartın çerçevesi (birim, durumu ve "
"nedeni) her zaman gösterilir."

#, python-format
msgid "A channel has at most %(num)d calibration."
msgid_plural "A channel has at most %(num)d calibrations."
msgstr[0] "Bir kanalın en fazla %(num)d kalibrasyonu olabilir."
msgstr[1] "Bir kanalın en fazla %(num)d kalibrasyonu olabilir."

msgid ""
"A channel is one value a device sends: what it measures, where it is in the message and how it is"
" stored."
msgstr ""
"Kanal, bir cihazın gönderdiği tek bir değerdir: neyi ölçtüğü, mesajda nerede olduğu ve nasıl "
"saklandığı."

msgid "A channel needs an owner: make another member an owner first."
msgstr "Bir kanalın sahibi olmalı: önce başka bir üyeyi sahip yapın."

msgid ""
"A channel that stores a value when it moves counts the values it did not store at the row that "
"closes their run: less than two heartbeats late."
msgstr ""
"Değer değiştiğinde saklayan bir kanal, saklamadığı değerleri o seriyi kapatan satırda sayar: en "
"fazla iki nabızdan kısa bir gecikmeyle."

msgid "A channel with this name already exists."
msgstr "Bu adda bir kanal zaten var."

msgid "A checklist can be added once the recurring task is created."
msgstr "Kontrol listesi, yinelenen görev oluşturulduktan sonra eklenebilir."

msgid "A checklist can be added once the task is created."
msgstr "Kontrol listesi, görev oluşturulduktan sonra eklenebilir."

#, python-format
msgid "A checklist has at most %(num)d line."
msgid_plural "A checklist has at most %(num)d lines."
msgstr[0] "Bir kontrol listesi en çok %(num)d satırdır."
msgstr[1] "Bir kontrol listesi en çok %(num)d satırdır."

msgid "A combination is numbered 1 to 9."
msgstr "Bir kombinasyon 1 ile 9 arasında numaralanır."

msgid "A connection is an MQTT broker the ingest service listens to. Its devices say which topics."
msgstr ""
"Bağlantı, veri alım servisinin dinlediği bir MQTT broker’ıdır. Hangi konuların dinleneceğini "
"cihazları belirler."

msgid "A correction of it has been started: discard that first."
msgstr "Bunun için bir düzeltme başlatılmış: önce onu silin."

msgid ""
"A count sets what a location holds at the end of its day; the difference from the book is shown "
"here."
msgstr "Sayım, bir yerin o günün sonunda tuttuğunu belirler; kayıtla farkı burada gösterilir."

msgid ""
"A credential is the name and secret a device or gateway signs in to the broker with. The secret "
"is shown once, when it is made."
msgstr ""
"Kimlik bilgisi, bir cihazın veya ağ geçidinin broker’a giriş yaptığı ad ve gizli anahtardır. "
"Gizli anahtar yalnızca oluşturulduğunda bir kez gösterilir."

#, python-format
msgid ""
"A cull of %(batch)s on %(date)s has the reason “%(reason)s”, which is none of Mattilsynet’s six "
"causes for cleaner fish."
msgstr ""
"%(batch)s’in %(date)s tarihli itlafının nedeni “%(reason)s”; bu, Mattilsynet’in temizleyici "
"balıklar için belirlediği altı nedenden biri değil."

msgid "A day in the period"
msgstr "Dönemdeki bir gün"

msgid "A deadband above 0, unless every value is stored."
msgstr "Her değer saklanmıyorsa ölü bant 0’dan büyük olmalıdır."

#, python-format
msgid ""
"A deadband of %(value)s is finer than the precision of %(quantity)s, %(step)s: a smaller change "
"is noise."
msgstr ""
"%(value)s ölü bandı, %(quantity)s hassasiyetinden (%(step)s) daha incedir: daha küçük bir değişim"
" gürültüdür."

msgid "A delivery puts stock into a location."
msgstr "Teslimat bir yere stok koyar."

msgid "A department cannot be its own parent."
msgstr "Bir departman kendi üst departmanı olamaz."

msgid "A department cannot be nested under itself or under one of its own departments."
msgstr "Bir departman kendi altına ya da kendi alt departmanlarından birinin altına yerleştirilemez."

msgid "A depth point has a depth, and no other point does."
msgstr "Derinlik noktasının bir derinliği vardır, başka hiçbir noktanın yoktur."

msgid "A depth point has a depth."
msgstr "Derinlik noktasının bir derinliği vardır."

msgid ""
"A device publishes on one topic of a connection: a probe, a PLC, a gateway. Its channels are the "
"values it sends."
msgstr ""
"Cihaz, bir bağlantının tek bir konusunda yayın yapar: bir prob, bir PLC, bir ağ geçidi. "
"Kanalları, gönderdiği değerlerdir."

msgid "A device’s topic has no “#”."
msgstr "Bir cihazın konusunda “#” bulunmaz."

msgid "A diagnosis is suspected or confirmed; without a diagnosis there is nothing to confirm."
msgstr "Bir tanı şüpheli veya doğrulanmıştır; tanı yoksa doğrulanacak bir şey yoktur."

msgid "A diet level names a protocol; another level has a label."
msgstr "Bir yem rejimi düzeyi bir protokolü adlandırır; diğer düzeylerin etiketi vardır."

msgid ""
"A disabled credential cannot sign in once the broker’s files are written again (manage.py "
"sensor_broker_sync)."
msgstr ""
"Devre dışı bir kimlik bilgisi, broker’ın dosyaları yeniden yazıldıktan sonra giriş yapamaz "
"(manage.py sensor_broker_sync)."

msgid "A disease notice is about a health event; a welfare notice may be; no other report is."
msgstr ""
"Hastalık bildirimi bir sağlık olayı hakkındadır; refah bildirimi olabilir; başka hiçbir rapor "
"değildir."

msgid "A document in the library"
msgstr "Kütüphanedeki bir belge"

msgid "A dose needs its unit, and a unit its dose."
msgstr "Doz birimiyle, birim de dozuyla girilir."

msgid "A draft copy with this table, to change and assign from a date."
msgstr "Bu tabloyla bir taslak kopya: değiştirip bir tarihten itibaren atamak için."

msgid ""
"A factor is what the groups differ in: the diet, whose levels are feeding protocols (how the farm"
" applies it), or another factor such as a temperature, whose levels are labels. Each group has "
"one level of each factor and its replicates, the tanks of which are placed on the Places tab. The"
" design is saved as a whole."
msgstr ""
"Faktör, grupların birbirinden ayrıldığı şeydir: düzeyleri yemleme protokolleri olan yem rejimi "
"(çiftlik onu böyle uygular) ya da düzeyleri etiket olan sıcaklık gibi başka bir faktör. Her "
"grubun her faktörden bir düzeyi ve tekrarları vardır; tekrarların tankları Yerleşim sekmesinde "
"yerleştirilir. Tasarım bütün olarak kaydedilir."

#, python-format
msgid "A feed has at most %(num)d row."
msgid_plural "A feed has at most %(num)d rows."
msgstr[0] "Bir yemin en fazla %(num)d satırı olabilir."
msgstr[1] "Bir yemin en fazla %(num)d satırı olabilir."

#, python-format
msgid "A feeder has at most %(num)d calibration."
msgid_plural "A feeder has at most %(num)d calibrations."
msgstr[0] "Bir yemleme makinesinin en fazla %(num)d kalibrasyonu olabilir."
msgstr[1] "Bir yemleme makinesinin en fazla %(num)d kalibrasyonu olabilir."

msgid "A feeding can still be recorded."
msgstr "Yemleme yine de kaydedilebilir."

msgid ""
"A feeding record names no lot: the book draws the site's lots first expired first out, so this is"
" an estimate."
msgstr ""
"Yemleme kaydı lot belirtmez: kayıt sahanın lotlarından süresi önce dolan önce düşülür, bu yüzden "
"bu bir tahmindir."

msgid "A feeding table has at least one band."
msgstr "Bir yemleme tablosunda en az bir ağırlık aralığı olmalı."

msgid "A file name only: letters, digits, dot, hyphen and underscore."
msgstr "Yalnızca dosya adı: harf, rakam, nokta, kısa çizgi ve alt çizgi."

msgid "A filed report is never deleted: start a correction instead."
msgstr "Sunulmuş bir rapor asla silinmez: bunun yerine bir düzeltme başlatın."

msgid ""
"A filing has its time, who recorded it, how it was filed and, unless it was phoned in, its "
"receipt or reference."
msgstr ""
"Bir sunumun zamanı, kimin kaydettiği, nasıl sunulduğu ve telefonla bildirilmediyse makbuzu veya "
"referansı vardır."

msgid "A flow can be stated for an inlet or an outlet only."
msgstr "Debi yalnızca bir giriş veya çıkış için belirtilebilir."

msgid ""
"A group has fewer than two replicates: its variation within the group cannot be told from the "
"difference between groups."
msgstr "Bir grubun ikiden az tekrarı var: grup içi değişim, gruplar arası farktan ayırt edilemez."

msgid "A harvest goes to a slaughter facility, a transport to a unit."
msgstr "Hasat bir kesimhaneye, taşıma bir birime gider."

msgid "A harvest is recorded from its unit’s drawer on Production units, or from its plan."
msgstr "Hasat, Üretim birimleri’nde biriminin panelinden veya planından kaydedilir."

msgid "A heartbeat from 10 seconds to 1 day (86400 seconds)."
msgstr "10 saniye ile 1 gün (86400 saniye) arasında bir nabız."

#, python-format
msgid ""
"A heartbeat of %(heartbeat)d seconds is shorter than the %(interval)d seconds the device sends "
"every."
msgstr "%(heartbeat)d saniyelik nabız, cihazın gönderim aralığı olan %(interval)d saniyeden kısadır."

msgid "A job that comes back: every day, on chosen weekdays, or on a day of the month."
msgstr "Tekrar eden bir iş: her gün, seçilen hafta günlerinde veya ayın bir gününde."

msgid "A keep-alive from 5 to 600 seconds."
msgstr "5 ile 600 saniye arasında bir keep-alive."

#, python-format
msgid "A last day older than %(date)s cannot be changed."
msgstr "%(date)s tarihinden eski bir son gün değiştirilemez."

msgid "A layout is a set of named values with a list of widgets, and nothing else."
msgstr "Bir yerleşim, bileşen listesi içeren adlandırılmış değerler kümesidir; başka bir şey değildir."

msgid "A leave type is a kind of leave, such as annual or parental leave. Add the types the company uses."
msgstr "İzin türü, yıllık ya da ebeveyn izni gibi bir izin çeşididir. Şirketin kullandığı türleri ekleyin."

msgid "A list of items needs the key that names the channel and the key of the value."
msgstr "Öğe listesi için kanalı adlandıran anahtar ve değerin anahtarı gerekir."

msgid "A list of items, each naming its channel"
msgstr "Her biri kendi kanalını adlandıran bir öğe listesi"

msgid "A list of items: the key of an item that names its channel, e.g. n."
msgstr "Öğe listesi: bir öğenin kanalını adlandıran anahtarı, örn. n."

msgid "A list of items: the key of an item’s value, e.g. v."
msgstr "Öğe listesi: bir öğenin değerinin anahtarı, örn. v."

msgid "A list of items: the name the item of this channel has, e.g. do."
msgstr "Öğe listesi: bu kanalın öğesinin adı, örn. do."

msgid "A list of items: where the list is, e.g. /items; empty when the message is the list."
msgstr "Öğe listesi: listenin yeri, örn. /items; mesajın kendisi liste ise boş."

msgid ""
"A listed disease is notified to Mattilsynet at once, already on suspicion (dyrehelseforskriften §"
" 7): the event’s page offers to start the notice."
msgstr ""
"Listelenmiş bir hastalık, şüphe aşamasında bile derhal Mattilsynet’e bildirilir "
"(dyrehelseforskriften § 7): olay sayfası bildirimi başlatmayı önerir."

msgid ""
"A listed disease is suspected or confirmed and Mattilsynet has not been notified: notify at once "
"(dyrehelseforskriften § 7), then record the filing of the notice."
msgstr ""
"Listelenmiş bir hastalık şüpheli veya doğrulanmış ve Mattilsynet’e bildirilmemiş: derhal bildirin"
" (dyrehelseforskriften § 7), ardından bildirimin sunulduğunu kaydedin."

#, python-format
msgid "A location has at most %(num)d reorder level."
msgid_plural "A location has at most %(num)d reorder levels."
msgstr[0] "Bir yerin en fazla %(num)d yeniden sipariş seviyesi olur."
msgstr[1] "Bir yerin en fazla %(num)d yeniden sipariş seviyesi olur."

msgid "A location stays on the site it was created on."
msgstr "Bir yer, oluşturulduğu sahada kalır."

#, python-format
msgid "A lot of %(category)s needs its number and its expiry date."
msgstr "%(category)s lotunun numarası ve son kullanma tarihi olmalı."

#, python-format
msgid "A medicine has at most %(num)d row."
msgid_plural "A medicine has at most %(num)d rows."
msgstr[0] "Bir ilacın en fazla %(num)d satırı olabilir."
msgstr[1] "Bir ilacın en fazla %(num)d satırı olabilir."

#, python-format
msgid "A medicine withdrawal holds batch %(batches)s, and this moves it: wait until it ends."
msgid_plural "Medicine withdrawals hold batches %(batches)s, and this moves them: wait until they end."
msgstr[0] ""
"Bir ilaç bekleme süresi %(batches)s partisini tutuyor ve bu onu değiştirir: süre bitene kadar "
"bekleyin."
msgstr[1] ""
"İlaç bekleme süreleri %(batches)s partilerini tutuyor ve bu onları değiştirir: süreler bitene "
"kadar bekleyin."

#, python-format
msgid ""
"A membrane (HDPE, PVC, EPDM) is %(low)s to %(high)s mm thick, concrete %(concrete_low)s to "
"%(concrete_high)s mm."
msgstr ""
"Membran (HDPE, PVC, EPDM) %(low)s ile %(high)s mm, beton %(concrete_low)s ile %(concrete_high)s "
"mm kalınlığındadır."

#, python-format
msgid "A message has at most %(count)d characters."
msgstr "Bir mesaj en fazla %(count)d karakter olabilir."

msgid ""
"A message the ingest could not store is kept here with how often it came. Beyond 1000 new ones "
"per connection and hour the rest are counted on one row. Readings are never refused for the dead "
"letters’ sake. Kept 90 days."
msgstr ""
"Veri alımının saklayamadığı bir mesaj, kaç kez geldiğiyle birlikte burada tutulur. Bağlantı "
"başına saatte 1000 yeni mesajdan sonrası tek bir satırda sayılır. Okumalar, kaydedilemeyen "
"mesajlar yüzünden asla reddedilmez. 90 gün saklanır."

msgid "A monthly task repeats on a day of the month; the others on none."
msgstr "Aylık bir görev ayın bir gününde yinelenir; diğerleri hiçbirinde."

msgid "A new experiment"
msgstr "Yeni bir deney"

msgid "A new protocol is a draft: fill in its feeding table, then set it active."
msgstr "Yeni bir protokol taslaktır: yemleme tablosunu doldurun, ardından aktif yapın."

#, python-format
msgid "A new unit starts as one of: %(statuses)s."
msgstr "Yeni bir birim şunlardan biriyle başlar: %(statuses)s."

msgid ""
"A new unit starts in one of these: it holds no fish yet. It becomes active when fish are stocked "
"in it; harvesting, cleaning and quarantine come later."
msgstr ""
"Yeni bir birim bunlardan biriyle başlar: henüz balık yoktur. İçine balık stoklanınca aktif olur; "
"hasat, temizlik ve karantina daha sonra gelir."

#, python-format
msgid "A note is at most %(count)d characters."
msgstr "Bir not en çok %(count)d karakterdir."

#, python-format
msgid "A page shows at most %(days)s day: the first day was moved."
msgid_plural "A page shows at most %(days)s days: the first day was moved."
msgstr[0] "Bir sayfa en fazla %(days)s gün gösterir: ilk gün kaydırıldı."
msgstr[1] "Bir sayfa en fazla %(days)s gün gösterir: ilk gün kaydırıldı."

msgid ""
"A payload format says how a kind of device writes its messages: where the time is, and where each"
" value is."
msgstr ""
"Mesaj biçimi, bir cihaz türünün mesajlarını nasıl yazdığını belirtir: zamanın ve her değerin "
"nerede olduğu."

msgid "A pending request has no decider and no decision time."
msgstr "Bekleyen talebin karar vereni ve karar zamanı yoktur."

msgid "A person cannot be placed before they joined."
msgstr "Bir kişi işe girmeden önceki bir güne yerleştirilemez."

msgid "A person cannot leave before they joined."
msgstr "Bir kişi işe girmeden önce ayrılamaz."

msgid "A person who has left cannot be placed after their last day."
msgstr "İşten ayrılan bir kişi son gününden sonra yerleştirilemez."

msgid "A person with an account is named by it; one without needs a last name."
msgstr "Hesabı olan kişi hesabın adıyla anılır; hesabı olmayanın soyadı gerekir."

msgid "A person without an account needs a last name."
msgstr "Hesabı olmayan kişinin soyadı gerekir."

msgid ""
"A person’s request to be away from a first to a last day, and how it was decided; its reason and "
"note are masked."
msgstr ""
"Bir kişinin ilk günden son güne kadar yok olma talebi ve nasıl karara bağlandığı; gerekçesi ve "
"notu gizlenir."

msgid ""
"A piece of knowledge in your own words, with its source: a document of the library, another "
"published source, or an expert’s or your own observation."
msgstr ""
"Kendi sözlerinizle bir bilgi ve kaynağı: kütüphaneden bir belge, yayımlanmış başka bir kaynak ya "
"da bir uzmanın veya sizin gözleminiz."

msgid "A placement cannot end before it starts."
msgstr "Bir yerleştirme başlamadan bitemez."

#, python-format
msgid "A plan can be dated at most %(days)d days back."
msgstr "Bir plan en fazla %(days)d gün geriye tarihlenebilir."

msgid ""
"A plan is done when the harvest or transfer recorded from it counts; voiding that operation plans"
" it again. The fast a plan asks of its unit starts at the start of its day less the handling "
"rule’s hours."
msgstr ""
"Bir plan, ondan kaydedilen hasat veya transfer geçerli olduğunda tamamlanır; o işlemi iptal etmek"
" planı yeniden planlanmış yapar. Planın biriminden istediği aç bırakma, gününün başlangıcından "
"elleçleme kuralının saatleri kadar önce başlar."

#, python-format
msgid "A planned %(plan)s is recorded as a %(operation)s."
msgstr "Planlanmış bir %(plan)s, %(operation)s olarak kaydedilir."

msgid "A planned slaughter is reported for a slaughter facility, every other report for a site."
msgstr "Planlı kesim bir kesimhane için bildirilir, diğer her rapor bir saha içindir."

msgid ""
"A point is a named place on a unit, a loop or a piece of equipment where water is sampled: its "
"inlet, its middle, its outlets. A new unit or system gets its points when it is created."
msgstr ""
"Nokta, bir birimde, bir döngüde veya bir ekipman parçasında suyun örneklendiği adlandırılmış bir "
"yerdir: girişi, ortası, çıkışları. Yeni bir birim veya sistem oluşturulduğunda noktalarını alır."

msgid "A point is on one unit, one system or one piece of equipment."
msgstr "Bir nokta bir birimde, bir sistemde veya bir ekipman parçasındadır."

msgid ""
"A point that has samples is not deleted, so its history stays: make it inactive instead. An "
"inactive point takes no new samples."
msgstr ""
"Numunesi olan bir nokta silinmez, geçmişi kalır: bunun yerine pasif yapın. Pasif bir nokta yeni "
"numune almaz."

msgid "A port from 1 to 65535."
msgstr "1 ile 65535 arasında bir port."

msgid "A price needs its currency, and a currency needs a price."
msgstr "Fiyatın bir para birimi, para biriminin de bir fiyatı olmalı."

msgid "A process value is bound to a piece of equipment or a system."
msgstr "Proses değeri bir ekipman parçasına veya bir sisteme atanır."

msgid "A production department stays on the site it was created on."
msgstr "Üretim departmanı, oluşturulduğu sahada kalır."

#, python-format
msgid ""
"A protocol gives, per weight band of the fish, the feed, the meals a day and the specific feeding"
" rate (SFR, %% of the body weight a day) at each temperature column, with the FCR it expects. A "
"ration is worked out from it on read: the fish, their estimated weight and the unit’s temperature"
" (Meal board)."
msgstr ""
"Bir protokol, balığın her ağırlık aralığı için yemi, günlük öğün sayısını ve her sıcaklık "
"sütunundaki spesifik yemleme oranını (SFR, günlük vücut ağırlığının %%’si) beklediği FCR ile "
"birlikte verir. Rasyon, okunurken bundan hesaplanır: balıklar, tahmini ağırlıkları ve birimin "
"sıcaklığı (Öğün panosu)."

msgid ""
"A protocol is assigned to units (it feeds whatever is in them), to a whole batch (it follows the "
"batch into every unit it is moved to) or to a batch in chosen units. For a batch in a unit the "
"most specific row in force applies: batch in unit, then unit, then whole batch. A row may be "
"changed or deleted before its first day; afterwards it is ended by its last day."
msgstr ""
"Bir protokol birimlere (içlerinde ne varsa onu yemler), bir partinin tamamına (parti hangi birime"
" taşınırsa onunla birlikte gider) ya da seçilen birimlerdeki bir partiye atanır. Bir birimdeki "
"parti için yürürlükteki en özel satır uygulanır: önce birimdeki parti, sonra birim, sonra tüm "
"parti. Bir satır ilk gününden önce değiştirilebilir ya da silinebilir; sonrasında son günü "
"girilerek sona erdirilir."

msgid "A randomised allocation has its seed; one placed by hand has its reason."
msgstr "Rastgele dağıtımın tohumu vardır; elle yerleştirmenin gerekçesi vardır."

msgid "A recipe takes two reagents: choose at least two (the Reagents tab)."
msgstr "Bir reçete iki kimyasal ister: en az ikisini seçin (Kimyasallar sekmesi)."

#, python-format
msgid ""
"A recurring task plans its tasks up to two weeks ahead; they are on the <a "
"href=\"%(url)s\">Tasks</a> page. Changing or pausing it plans the tasks from today on that nobody"
" has touched again; the others stay as they are."
msgstr ""
"Yinelenen bir görev, görevlerini iki hafta öncesinden planlar; bunlar <a "
"href=\"%(url)s\">Görevler</a> sayfasındadır. Onu değiştirmek veya duraklatmak, bugünden itibaren "
"kimsenin dokunmadığı görevleri yeniden planlar; diğerleri olduğu gibi kalır."

msgid "A remark for the lead’s own planning; it is not shown in the log."
msgstr "Ekip liderinin kendi planlaması için bir not; günlükte gösterilmez."

msgid "A replicate was removed meanwhile: reload the page."
msgstr "Bir tekrar bu arada kaldırıldı: sayfayı yeniden yükleyin."

msgid "A report is for a period, a notice for an event."
msgstr "Bir rapor bir dönem içindir, bir bildirim bir olay içindir."

msgid ""
"A report to Mattilsynet or Fiskeridirektoratet, computed from the records: you check it, file it "
"yourself and record here that you did."
msgstr ""
"Mattilsynet’e veya Fiskeridirektoratet’e kayıtlardan hesaplanan bir rapor: siz kontrol edersiniz,"
" kendiniz sunarsınız ve sunduğunuzu burada kaydedersiniz."

#, python-format
msgid "A round takes at most %(rows)d rows."
msgstr "Bir tur en çok %(rows)d satır alır."

msgid ""
"A rule gives a template to a unit, a system, a type of system, a species or a kind of unit; the "
"most specific rule wins."
msgstr ""
"Bir kural; bir birime, sisteme, sistem türüne, türe veya birim çeşidine şablon verir; en özgül "
"kural kazanır."

msgid "A rule is for one unit, system, system type, species or kind, or for every unit."
msgstr ""
"Bir kural tek bir birim, sistem, sistem türü, tür veya birim çeşidi içindir ya da her birim "
"içindir."

msgid "A rule is on one channel or on every channel of a quantity."
msgstr "Bir kural tek bir kanal ya da bir parametrenin tüm kanalları için geçerlidir."

msgid ""
"A rule says when a channel needs a look: no fresh value, its device offline, a value above or "
"below a threshold, or a change too fast."
msgstr ""
"Kural, bir kanala ne zaman bakılması gerektiğini belirtir: güncel değer yok, cihazı çevrimdışı, "
"değer bir eşiğin üstünde veya altında ya da çok hızlı bir değişim."

msgid "A sample is the number of fish weighed and their weight together."
msgstr "Bir örnek, tartılan balık sayısı ile toplam ağırlıklarıdır."

msgid ""
"A sample says where it was taken: at one of these points. A unit’s water, as the rations, the "
"withdrawal and the Production units page read it, is its middle point. The flow and the share of "
"the outflow are the design or last-known figures a mass balance will start from; nothing here is "
"measured."
msgstr ""
"Bir numune nerede alındığını söyler: bu noktalardan birinde. Bir birimin suyu, rasyonların, "
"bekleme süresinin ve Üretim birimleri sayfasının okuduğu şekliyle, orta noktasının suyudur. Debi "
"ve çıkış payı, bir kütle dengesinin başlayacağı tasarım veya son bilinen değerlerdir; burada "
"hiçbir şey ölçülmez."

msgid "A sea cage site needs latitude and longitude."
msgstr "Deniz kafesi sahası için enlem ve boylam gerekir."

msgid "A sea-lice medicine names its substance as the lice report has it; other medicines have none."
msgstr "Deniz biti ilacı etken maddesini bit raporundaki adıyla belirtir; diğer ilaçlarda yoktur."

msgid "A sea-lice medicine only: its substance as Mattilsynet’s weekly lice report names it."
msgstr "Yalnız deniz biti ilacı: etken maddesi, Mattilsynet’in haftalık bit raporundaki adıyla."

msgid ""
"A second person must approve going on past a medicine withdrawal (the platform owner’s setting), "
"and that approval cannot be given here yet."
msgstr ""
"İlaç arınma süresine rağmen devam etmeyi ikinci bir kişinin onaylaması gerekiyor (platform "
"sahibinin ayarı) ve bu onay henüz burada verilemiyor."

msgid "A share of the outflow, from 0 to 100 %, can be stated for an outlet only."
msgstr "Çıkış payı, 0 ile 100 % arasında, yalnızca bir çıkış için belirtilebilir."

msgid "A shift cannot start and end at the same time."
msgstr "Bir vardiya aynı anda başlayıp bitemez."

msgid ""
"A shift is a start and an end on the wall clock of the site, with a break. Add the shifts the "
"roster uses."
msgstr ""
"Vardiya, sahanın duvar saatine göre bir başlangıç ve bitiştir; bir mola içerir. Çizelgenin "
"kullandığı vardiyaları ekleyin."

msgid "A short rest, a long week or too many days in a row"
msgstr "Kısa dinlenme, uzun hafta ya da çok fazla art arda gün"

msgid "A silo only: the feeder it fills, on the same site."
msgstr "Yalnızca silo: beslediği yemleme makinesi, aynı sahada."

msgid "A simulated value, not the real water."
msgstr "Simüle edilmiş bir değer, gerçek su değil."

msgid "A simulator or test device: its values are stored marked simulated and used nowhere."
msgstr ""
"Bir simülatör veya test cihazı: değerleri simüle edilmiş olarak işaretlenip saklanır ve hiçbir "
"yerde kullanılmaz."

msgid ""
"A site averages the averages of its units counted that week, every unit weighing the same, and "
"must stay below the limit: 0.5 adult female lice per fish, 0.2 in the spring weeks "
"(lakselusforskriften § 8 and Vedlegg 1). The latest count of each unit in the week counts."
msgstr ""
"Bir sahanın ortalaması, o hafta sayılan birimlerinin ortalamalarının ortalamasıdır, her birim "
"aynı ağırlıkta; sınırın altında kalmalıdır: balık başına 0,5 ergin dişi bit, bahar haftalarında "
"0,2 (lakselusforskriften § 8 ve Vedlegg 1). Her birimin o haftaki son sayımı geçerlidir."

msgid ""
"A species the farm grows or stocks, such as Atlantic salmon or lumpfish: its names, its codes for"
" the reports and the water it lives in."
msgstr ""
"Çiftliğin yetiştirdiği veya stokladığı bir balık türü, örneğin Atlantik somonu veya lompa balığı:"
" adları, resmî bildirim kodları ve yaşadığı su."

msgid "A started experiment has its day 0, hypothesis, primary endpoint and allocation."
msgstr "Başlamış bir denemenin 0. günü, hipotezi, birincil sonuç değişkeni ve dağıtımı vardır."

msgid ""
"A storage location is a place on a site where stock is kept: a feed store, a silo, a cold room, a"
" medicine cabinet."
msgstr "Depolama yeri, bir sahada stok tutulan yerdir: yem deposu, silo, soğuk oda, ilaç dolabı."

msgid "A strength needs its unit, and a unit its strength."
msgstr "Güç birimiyle, birim de gücüyle girilir."

msgid "A supplier of laboratory analyses."
msgstr "Laboratuvar analizi tedarikçisi."

msgid "A supplier of medicines and vaccines (Purchasing › Suppliers)."
msgstr "İlaç ve aşı tedarikçisi (Satın alma › Tedarikçiler)."

msgid "A supplier of veterinary and fish health services (Purchasing › Suppliers)."
msgstr "Veteriner ve balık sağlığı hizmeti tedarikçisi (Satın alma › Tedarikçiler)."

msgid ""
"A suspicion of resistance to a treatment against lice in the week (lakselusforskriften § 10 e): "
"the substance and why it is suspected. Saved separately from the report."
msgstr ""
"Haftada bit tedavisine karşı direnç şüphesi (lakselusforskriften § 10 e): etken madde ve şüphenin"
" nedeni. Rapordan ayrı kaydedilir."

msgid "A system cannot be its own parent."
msgstr "Bir sistem kendi üst sistemi olamaz."

msgid "A system is a RAS, a pond, a cage line or a hatchery on a site; tanks and equipment belong to it."
msgstr ""
"Sistem, bir sahadaki bir RAS, havuz, kafes hattı veya kuluçkahanedir; tanklar ve ekipman ona "
"bağlıdır."

msgid "A system stays on the site it was created on."
msgstr "Sistem, oluşturulduğu sahada kalır."

#, python-format
msgid "A table has at most %(count)d temperature columns."
msgstr "Bir tabloda en fazla %(count)d sıcaklık sütunu olabilir."

msgid "A tank was booked to another experiment meanwhile: look at the places and try again."
msgstr "Bir tank bu arada başka bir denemeye ayrıldı: yerleşimlere bakın ve yeniden deneyin."

msgid "A tank, a pond or a cage; it cannot be changed later."
msgstr "Tank, havuz veya kafes; sonradan değiştirilemez."

msgid "A task is a job at one place for the people who do it, due on a day."
msgstr "Görev, belirli bir günde bitmesi gereken, tek bir yerde, onu yapacak kişiler için bir iştir."

#, python-format
msgid "A team has at most %(num)d person."
msgid_plural "A team has at most %(num)d people."
msgstr[0] "Bir ekipte en fazla %(num)d kişi olabilir."
msgstr[1] "Bir ekipte en fazla %(num)d kişi olabilir."

#, python-format
msgid "A temperature column has at most one decimal: %(value)s."
msgstr "Bir sıcaklık sütununda en fazla bir ondalık basamak olabilir: %(value)s."

#, python-format
msgid "A temperature column is between %(low)s and %(high)s °C."
msgstr "Bir sıcaklık sütunu %(low)s ile %(high)s °C arasındadır."

msgid "A template"
msgstr "Bir şablon"

msgid "A template cannot flip to itself."
msgstr "Bir şablon kendisine geçiş yapamaz."

msgid "A template has no tanks: it is a design to copy."
msgstr "Şablonun tankı yoktur: kopyalanacak bir tasarımdır."

msgid "A template is a draft design without a start day or an allocation."
msgstr "Şablon, başlangıç günü ve dağıtımı olmayan taslak bir tasarımdır."

msgid "A template is not started: copy it into an experiment."
msgstr "Şablon başlatılmaz: bir deney olarak kopyalayın."

msgid "A topic has at most one “+”."
msgstr "Bir konuda en fazla bir “+” bulunur."

msgid "A topic starting with “$” is the broker’s own."
msgstr "“$” ile başlayan bir konu broker’ın kendisine aittir."

msgid ""
"A transfer is a transport. A grading is checked against its own rule and the transport rule; the "
"longer applies."
msgstr ""
"Transfer bir taşımadır. Boylama kendi kuralına ve taşıma kuralına göre denetlenir; uzun olan "
"geçerlidir."

msgid "A treatment is of the units of one site: record one for each site."
msgstr "Bir tedavi tek bir sahanın birimlerine aittir: her saha için ayrı kaydedin."

msgid "A treatment with it holds the fish with an unknown end until a withdrawal is added."
msgstr ""
"Bununla yapılan bir tedavi, bekleme süresi eklenene kadar balıkları bitişi bilinmeyen bir bekleme"
" süresinde tutar."

msgid "A treatment without a medicine names none."
msgstr "İlaçsız bir tedavi ilaç belirtmez."

msgid ""
"A treatment without a medicine names none: choose a bath, medicated feed, injection or dip as the"
" method."
msgstr ""
"İlaçsız bir tedavi ilaç belirtmez: yöntem olarak banyo, ilaçlı yem, enjeksiyon veya daldırma "
"seçin."

msgid ""
"A trial of one species on one site: its groups, their replicates and the tanks and days each is "
"booked to. A draft reserves its tanks; starting it fixes its design, and the figures are read "
"from the farm’s own records."
msgstr ""
"Tek bir saha ve tek bir tür üzerinde deneme: grupları, tekrarları ve her birinin ayrıldığı "
"tanklar ve günler. Taslak tanklarını ayırır; başlatmak tasarımı sabitler ve rakamlar çiftliğin "
"kendi kayıtlarından okunur."

msgid "A unit becomes active when fish are stocked in it (Operations › Production units)."
msgstr "Bir birim, içine balık stoklandığında aktif olur (Operasyonlar › Üretim birimleri)."

msgid "A unit can be harvested only while fish are in it."
msgstr "Bir birimde hasat ancak içinde balık varken yapılabilir."

#, python-format
msgid "A unit cannot go from %(old)s to %(new)s."
msgstr "Bir birim %(old)s durumundan %(new)s durumuna geçemez."

msgid "A unit cost needs its currency, and a currency a unit cost."
msgstr "Birim maliyetin para birimi, para biriminin de birim maliyeti olmalı."

msgid ""
"A unit takes the water values at its middle point; a system takes them as its own water. A "
"process value goes to a system or a piece of equipment."
msgstr ""
"Bir birim su değerlerini orta noktasında alır; bir sistem onları kendi suyu olarak alır. Bir "
"proses değeri bir sisteme veya bir ekipmana gider."

msgid "A unit with fish in it cannot be made inactive: move or harvest them first."
msgstr "İçinde balık olan bir birim pasif yapılamaz: önce balıkları taşıyın veya hasat edin."

msgid "A vaccination is given with a vaccine."
msgstr "Aşılama bir aşıyla yapılır."

msgid "A vaccine is given as a vaccination, and a vaccination with a vaccine."
msgstr "Aşı aşılama olarak verilir, aşılama da aşıyla."

msgid ""
"A value is fresh for three heartbeats of its channel. A stale value is not used for a unit’s "
"water: the next source counts (its system’s sensor, then the latest sample)."
msgstr ""
"Bir değer, kanalının üç nabzı boyunca günceldir. Eski bir değer bir birimin suyu için "
"kullanılmaz: sıradaki kaynak geçerli olur (sisteminin sensörü, ardından en son numune)."

msgid ""
"A value is stored again when it moves this much from the last stored one, in the quantity’s unit."
" Empty: the quantity’s default."
msgstr ""
"Bir değer, son saklanandan bu kadar değiştiğinde yeniden saklanır; parametrenin biriminde. Boş: "
"parametrenin varsayılanı."

msgid ""
"A value is stored at least this often even when it does not move. Fresh for three heartbeats. "
"Empty: the quantity’s default."
msgstr ""
"Bir değer değişmese bile en az bu sıklıkla saklanır. Üç nabız boyunca günceldir. Boş: "
"parametrenin varsayılanı."

msgid ""
"A value outside the range is stored, marked, and used nowhere. Empty on a new channel: what the "
"quantity can be."
msgstr ""
"Aralık dışındaki bir değer saklanır, işaretlenir ve hiçbir yerde kullanılmaz. Yeni bir kanalda "
"boş: parametrenin alabileceği değerler."

msgid ""
"A water on the Water Quality Management Chart and against the pH, the pH where each limit is "
"reached, and what to dose to reach a target. The limits start as defaults, not as the limits of "
"your fish, unless the values come from a unit. The results follow the values as you change them. "
"Nothing is stored."
msgstr ""
"Bir su, Su Kalitesi Yönetim Çizelgesinde ve pH’ye göre: her sınıra ulaşılan pH ve bir hedefe "
"ulaşmak için ne dozlanacağı. Değerler bir birimden gelmedikçe sınırlar balıklarınızın sınırları "
"değil, varsayılanlardır. Sonuçlar değerleri değiştirdikçe güncellenir. Hiçbir şey kaydedilmez."

msgid ""
"A water value goes to a sampling point or a system; a process value (flow, level, power…) to a "
"piece of equipment or a system."
msgstr ""
"Su değeri bir numune noktasına veya bir sisteme; proses değeri (debi, seviye, güç…) bir ekipman "
"parçasına veya bir sisteme gider."

msgid "A water value is bound to a sampling point or a system."
msgstr "Su değeri bir numune noktasına veya bir sisteme atanır."

msgid "A weekly task repeats on at least one weekday; the others on none."
msgstr "Haftalık bir görev en az bir hafta gününde yinelenir; diğerleri hiçbirinde."

msgid "A whole number: the same pool and seed always give the same placements."
msgstr "Bir tam sayı: aynı havuz ve tohum her zaman aynı yerleşimleri verir."

msgid "A wide chart scrolls sideways inside its frame."
msgstr "Geniş bir şema kendi çerçevesi içinde yana kayar."

msgid "A year class is a year, e.g. 2026."
msgstr "Yıl sınıfı bir yıldır, örneğin 2026."

msgid "A “+” stands for a whole level of the topic, between slashes."
msgstr "“+”, konunun iki eğik çizgi arasındaki tüm bir seviyesinin yerini tutar."

msgid "API id"
msgstr "API kimliği"

msgid "Abnormal swimming"
msgstr "Anormal yüzme"

msgid "Above"
msgstr "Üstünde"

msgid ""
"Above or below: every value of this time must be past the threshold. No fresh value: this long "
"past the channel’s freshness. A rate: the change over this time."
msgstr ""
"Üstünde veya altında: bu süredeki her değer eşiği geçmiş olmalıdır. Güncel değer yok: kanalın "
"güncellik süresini bu kadar aşmış. Hız: bu süredeki değişim."

msgid "Above the max density, accepted"
msgstr "Azami yoğunluğun üstü, kabul edildi"

msgid "Above the usual feed rate, accepted"
msgstr "Olağan yemleme oranının üzerinde, onaylandı"

msgid "Above, below and a rate need a threshold."
msgstr "Üstünde, altında ve hız için bir eşik gerekir."

