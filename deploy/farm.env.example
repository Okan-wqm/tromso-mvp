# One farm's server settings (docs/ops/install.md). Copy to farm.env (never committed: .gitignore), fill in, and run
# compose with --env-file farm.env. No secret goes in this file: passwords and keys are files under SECRETS_DIR, made by
# scripts/make-secrets.sh. Every value below is a placeholder.

# The installation's name: the compose project, and this farm's name in the backup repository.
COMPOSE_PROJECT_NAME=farm-example
# The host name people open the console at (the TLS certificate's name). Links in the e-mails start with https://SITE_HOST.
SITE_HOST=farm.example.invalid
# Where the secret files are: outside the repository on a real server (root only, mode 0700 on the folder).
SECRETS_DIR=/etc/balik/farm-example/secrets
# The database's name (one database per farm, on this farm's own server).
DB_NAME=balik

# The images: built here from this checkout (docker compose build), tagged with the release.
WEB_IMAGE=balik-web:local
DB_IMAGE=balik-db:local
BACKUP_IMAGE=balik-backup:local
INGEST_IMAGE=balik-ingest:local

# Mail (README, Email): the invitations and password resets.
EMAIL_HOST=smtp.example.invalid
EMAIL_PORT=587
EMAIL_TLS=starttls
EMAIL_HOST_USER=farm-mailer
# Remove this line when the SMTP server takes no sign-in; the password itself is SECRETS_DIR/email_password.
EMAIL_HOST_PASSWORD_FILE=/run/secrets/email_password
DEFAULT_FROM_EMAIL=Farm console <console@farm.example.invalid>

# The company (until the platform settings hold them).
COMPANY_NAME=Example Farm
COMPANY_TIME_ZONE=Europe/Oslo

# HTTPS: how long browsers are told to use https only, in seconds. Start lower (3600) on a first installation, raise to
# a year (31536000) once https works; 0 is refused.
DJANGO_HSTS_SECONDS=31536000

# Where the proxy listens (docs/ops/access.md). Docker publishes a port past the host's firewall (ufw does not see it),
# so exposure is chosen here, never left to the firewall:
#   127.0.0.1  nothing reaches the console from outside the server (the default; Cloudflare Tunnel needs no more)
#   10.8.0.1   the server's WireGuard address: only people on the VPN (the recommended pilot set-up)
#   0.0.0.0    the internet: only with a reason, and Cloudflare or an allowlist in front (docs/ops/access.md, C)
HTTPS_BIND=127.0.0.1
HTTP_BIND=127.0.0.1
# Behind Cloudflare Tunnel only: believe the client address cloudflared passes on, from the front network only (EDGE_SUBNET).
# PROXY_REAL_IP_FROM=172.31.250.0/24
# PROXY_REAL_IP_HEADER=CF-Connecting-IP
EDGE_SUBNET=172.31.250.0/24
# Submitted sign-in, password-reset and admin forms a minute per client address.
PROXY_SIGNIN_PER_MINUTE=10
# Where Django's admin (/admin/, restoring deleted records) may be opened from: the WireGuard range, or `all` only when
# Cloudflare Access with a second factor stands in front. The default lets nobody from outside the server in.
PROXY_ADMIN_ALLOW=10.8.0.0/24

# The MQTT broker's TLS listener for the field devices: the server's VPN address (WireGuard, docs/ops/access.md).
MQTT_BIND_ADDRESS=10.8.0.1
# clientcert: a client certificate and a password per device (the default); password: a password per device only.
MQTT_DEVICE_AUTH=clientcert

# Backups (docs/ops/backup-and-restore.md): the off-server restic repository. Its credentials, if any, go in
# SECRETS_DIR/backup.env; the repository's encryption password is SECRETS_DIR/restic_password.
# The design (docs/ops/backup-and-restore.md): this server's key may add to the repository, never delete. The
# recommended target is a restic REST server in append-only mode on a machine the owner runs elsewhere; the owner
# prunes from there (or another owner machine) with a key of their own.
# Its user and password are RESTIC_REST_USERNAME and RESTIC_REST_PASSWORD in SECRETS_DIR/backup.env, never here.
RESTIC_REPOSITORY=rest:https://backup.example.invalid:8000/farm-example/
# Never on a farm's server unless its key may delete anyway (then a stolen server can delete its backups).
BACKUP_PRUNE_ON_FARM=0
# The WAL is archived at least every DB_ARCHIVE_TIMEOUT seconds: with the ship interval it is what a lost server can
# lose (900 + 15 min: 30 minutes); a quiet database writes one 16 MB segment each time (docs/ops/backup-and-restore.md).
DB_ARCHIVE_TIMEOUT=900
BACKUP_DUMP_HOURS=24
BACKUP_BASE_DAYS=7
BACKUP_SHIP_MINUTES=15
BACKUP_KEEP_HOURLY=48
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12

# Sizes (a server of 4 cores and 8 GB).
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
DB_MEMORY=4g
DB_CPUS=2
DB_SHARED_BUFFERS=1GB
DB_MAX_CONNECTIONS=100
WEB_MEMORY=2g
WEB_CPUS=2
INGEST_MEMORY=1g
INGEST_CPUS=2
