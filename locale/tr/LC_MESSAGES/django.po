msgstr "%(tank)s aynı günlerin bazılarında iki kez yerleştirilmiş (%(first)s, %(second)s)."

#, python-format
msgid "%(tank)s of %(replicate)s is booked outside the days of the experiment."
msgstr "%(replicate)s için %(tank)s, deneyin günlerinin dışında ayrılmış."

#, python-format
msgid "%(tank)s of %(replicate)s is not on the site of the experiment."
msgstr "%(replicate)s için %(tank)s deneyin sahasında değil."

#, python-format
msgid "%(tank)s was deleted meanwhile."
msgstr "%(tank)s bu arada silindi."

#, python-format
