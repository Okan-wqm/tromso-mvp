msgstr "Analog"

msgid "Analysis"
msgstr "Analyse"

msgid "Another document in the library has this DOI."
msgstr "Et annet dokument i biblioteket har denne DOI-en."

msgid "Another feed already has this name."
msgstr "Et annet fôr har allerede dette navnet."

msgid "Another feed already uses this code."
msgstr "Et annet fôr bruker allerede denne koden."

msgid "Another feeding protocol already has this name."
msgstr "En annen fôringsprotokoll har allerede dette navnet."

msgid "Another production department already uses this code."
