"%(kilos)s kg is %(rate)s %% of the %(biomass)s kg %(unit)s holds on %(date)s in the book; more "
"than %(limit)s %% a day is unusual. Tick the box below to record it anyway."
msgstr ""
"%(kilos)s kg, %(unit)s biriminin %(date)s tarihinde kayıtlardaki %(biomass)s kg biyokütlesinin "
"%%%(rate)s kadarı; günde %%%(limit)s üzeri olağan dışıdır. Yine de kaydetmek için aşağıdaki "
"kutuyu işaretleyin."

#, python-format
msgid "%(kilos)s weighed"
msgstr "%(kilos)s tartıldı"

#, python-format
msgid "%(kind)s form sections"
msgstr "%(kind)s formu bölümleri"

