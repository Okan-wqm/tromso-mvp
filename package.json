{
  "name": "balik-ciftligi-frontend",
  "private": true,
  "description": "Sources of the browser code: the TypeScript, compiled into static/js (not committed), and the Tailwind source, built into static/css/tw.css (committed).",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/tailwind.mjs",
    "build:css": "node scripts/tailwind.mjs",
    "check:css": "node scripts/tailwind.mjs --check",
    "watch": "tsc -p tsconfig.json --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node scripts/mark-esm.mjs && node --test \".build/test/**/*.test.js\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "22.10.2",
    "axe-core": "4.10.2",
    "playwright-core": "1.49.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.6.3"
  }
}
