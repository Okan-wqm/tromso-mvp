msgid "%(system)s is on another site than the production department."
msgstr "%(system)s er på en annen lokalitet enn produksjonsavdelingen."

#, python-format
msgid ""
"%(tank)s already has the feeding protocol %(protocol)s assigned (%(period)s): end it first, for "
