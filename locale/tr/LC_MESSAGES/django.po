msgid "%(parameter)s: bounds from %(low)s to %(high)s, at most %(decimals)d decimals."
msgstr "%(parameter)s: sınırlar %(low)s ile %(high)s arasında, en çok %(decimals)d ondalık."

#, python-format
msgid "%(point)s is deleted."
msgstr "%(point)s silinmiş."

#, python-format
msgid "%(rating)s of 5"
msgstr "5 üzerinden %(rating)s"

#, python-format
msgid "%(record)s is the primary one"
msgstr "%(record)s birincil olan"

