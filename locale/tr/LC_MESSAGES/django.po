msgid "%(size)s mm"
msgstr "%(size)s mm"

#, python-format
msgid "%(size)s: %(grams)s g per shot, silo %(silo)s kg"
msgstr "%(size)s: atış başına %(grams)s g, silo %(silo)s kg"

#, python-format
msgid "%(species)s is %(status)s: a new batch takes an active or experimental species."
msgstr "%(species)s durumu %(status)s: yeni bir parti yalnızca aktif veya deneysel bir balık türü alır."

#, python-format
msgid "%(system)s is on another site than the production department."
msgstr "%(system)s, üretim departmanından farklı bir sahada."

#, python-format
msgid ""
"%(unit)s has the status %(status)s, so it cannot take fish: it can when it is active, preparing "
"or fallow."
msgstr ""
"%(unit)s şu an %(status)s durumunda, bu yüzden balık alamaz: aktif, hazırlanıyor veya "
"dinlendirmede durumundayken alabilir."

#, python-format
msgid "%(unit)s has the status %(status)s: set it to preparing or fallow in Setup to stock it."
msgstr ""
"%(unit)s şu an %(status)s durumunda: stoklamak için Kurulum’da hazırlanıyor veya dinlendirmede "
"durumuna alın."

#, python-format
msgid "%(unit)s holds no fish on %(date)s."
msgstr "%(unit)s biriminde %(date)s tarihinde balık yok."

#, python-format
msgid "%(unit)s is deleted and would hold fish again: restore it first."
msgstr "%(unit)s silinmiş ve yeniden balık tutacaktı: önce onu geri yükleyin."

#, python-format
msgid "%(unit)s is deleted."
msgstr "%(unit)s silinmiş."

#, python-format
msgid ""
"%(unit)s would hold %(kilos)s kg on %(date)s, %(percent)s %% of its max biomass (%(max)s kg at "
"%(density)s kg/m³). Tick the box below to stock it anyway."
msgstr ""
"%(unit)s %(date)s tarihinde %(kilos)s kg tutacak: azami biyokütlesinin %%%(percent)s kadarı "
"(%(density)s kg/m³ ile %(max)s kg). Yine de stoklamak için aşağıdaki kutuyu işaretleyin."

#, python-format
msgid "%(unit)s would hold %(species)s on %(date)s: a unit holds one species at a time."
msgstr ""
"%(unit)s %(date)s tarihinde %(species)s tutacaktı: bir birimde aynı anda tek bir balık türü "
"bulunur."

#. Translators: a percentage; write the sign where your language puts it (Turkish: %%%(value)s).
#, python-format
msgid "%(value)s %%"
msgstr "%%%(value)s"

#. Translators: an average weight in grams, e.g. 145 g.
#, python-format
msgid "%(value)s g"
msgstr "%(value)s g"

#. Translators: an amount of feed in kilograms, e.g. 12.5 kg.
#. Translators: a weight in kilograms, e.g. 1,798 kg.
#, python-format
msgid "%(value)s kg"
msgstr "%(value)s kg"

#, python-format
msgid "%(value)s kg/m³"
msgstr "%(value)s kg/m³"

