msgstr "Denne enheten har allerede en telling denne dagen: annuller den først for å rette den."

msgid "This unit has no active middle sampling point, so no water is shown for it."
msgstr "Denne enheten har ikke noe aktivt midtre prøvepunkt, så det vises ikke vann for den."

#, python-format
msgid "This unit holds %(count)d batch: the operation applies to the one chosen."
msgid_plural "This unit holds %(count)d batches: the operation applies to the one chosen."
msgstr[0] "Denne enheten har %(count)d fiskegruppe: operasjonen gjelder den som velges."
msgstr[1] "Denne enheten har %(count)d fiskegrupper: operasjonen gjelder den som velges."

