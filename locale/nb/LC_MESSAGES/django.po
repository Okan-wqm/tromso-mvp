msgid ""
"%(unit)s would hold %(species)s of very different sizes on %(date)s: %(heavy_batch)s at %(heavy)s"
" and %(light_batch)s at %(light)s, %(ratio)s times as heavy, above the limit of %(limit)s (Setup "
"› Species). Tick the box below to put them together anyway."
msgstr ""
"%(unit)s ville holdt %(species)s av svært ulik størrelse %(date)s: %(heavy_batch)s på %(heavy)s "
"og %(light_batch)s på %(light)s, %(ratio)s ganger så tung, over grensen på %(limit)s (Oppsett › "
"Arter). Kryss av i boksen under for å sette dem sammen likevel."

#, python-format
msgid ""
"%(unit)s would hold %(species)s on %(date)s: a unit holds one species at a time (cleaner fish "
