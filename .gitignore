.venv/
__pycache__/
*.pyc
db.sqlite3
.env
staticfiles/

# Compiled from frontend/*.ts by `npm run build`
static/js/
node_modules/

# Built from locale/*/LC_MESSAGES/django.po by `manage.py compile_catalogs`
*.mo

# Uploaded files (MEDIA_ROOT): never committed, never served as static files
/media/

# Sensors services: secrets and the broker files (docker-compose.yml profile sensors)
.sensors/
# The TypeScript test build (`npm test`)
.build/
# A farm's server (deploy/, docs/ops/): its secrets and its own settings never enter the repository
/deploy/secrets/
/deploy/farm.env
